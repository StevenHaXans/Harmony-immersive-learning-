{
  "name": "guardians-stripe",
  "private": true,
  "version": "1.0.0",
  "description": "Harmony API: Stripe card checkout, pan-African mobile money (pawaPay, M-Pesa Daraja, Airtel) and SMS / USSD / voice access for students",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "tsx --test src/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:webhooks": "node scripts/webhookcheck.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
