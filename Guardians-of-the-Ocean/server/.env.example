# ── Core ──
PORT=8787
# Leave empty locally to use the in-memory store (data resets on restart).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/guardians?sslmode=require
FRONTEND_ORIGIN=http://127.0.0.1:8765,http://localhost:8765
# Public origin of the static site, used for Stripe success / cancel URLs.
APP_BASE_URL=http://127.0.0.1:8765
# Public origin of THIS API, used to build provider callback URLs (Render sets RENDER_EXTERNAL_URL for you).
PUBLIC_API_URL=
# Secret path segment on every provider callback. Generate with: openssl rand -hex 24
CALLBACK_TOKEN=
# Bearer token for the guide desk (/mobile/agent.html) and broadcasts.
ADMIN_TOKEN=
# Browser phone simulator + practice payments. On by default outside production;
# in production it only stays on while no real gateway is configured.
DEV_TOOLS=

# ── Stripe card checkout (optional; needs DATABASE_URL too) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional shared secret. If set, Checkout requires Authorization: Bearer <value>
CHECKOUT_USER_SECRET=
# Default restoration credit amount in cents
CHECKOUT_AMOUNT_CENTS=2500
CHECKOUT_CURRENCY=usd

# ── Africa's Talking: SMS, USSD, voice (username "sandbox" = sandbox) ──
AT_USERNAME=
AT_API_KEY=
# Shortcode or alphanumeric sender ID approved on your account.
AT_SMS_FROM=
# Your AT voice number, e.g. +254711082000
AT_VOICE_NUMBER=

# Click Mobile: fallback SMS gateway. A failed Africa's Talking SMS is retried here.
# Request shape is a placeholder until Click Mobile issues API access (see src/comms/clickmobile.ts).
CLICKMOBILE_SMS_URL=
CLICKMOBILE_API_KEY=
CLICKMOBILE_SENDER=

# Shown to students on the web and in SMS.
USSD_CODE=*384*2026#
SMS_SHORTCODE=22384

# ── Safaricom Daraja, M-Pesa Express (STK push) ──
# Sandbox test shortcode 174379 and its passkey are on the Daraja portal (Lipa Na M-Pesa Online test credentials).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# paybill | till. For a till (Buy Goods) set MPESA_PARTY_B to the till number and MPESA_SHORTCODE to the store number.
MPESA_TYPE=paybill
MPESA_PARTY_B=
MPESA_ACCOUNT_REF=HARMONY

# ── pawaPay: pan-African mobile money (20 countries, one API) ──
# Carries every wallet without a direct integration, and Kenyan M-Pesa when Daraja is not set.
# Sandbox sign-up and token: https://dashboard.sandbox.pawapay.io
# Deposit callback URL to set in the pawaPay dashboard: {PUBLIC_API_URL}/api/pay/pawapay/callback/{CALLBACK_TOKEN}
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=

# Country used for numbers typed without a country code (ISO alpha-2: KE, UG, GH, NG, ZM...).
DEFAULT_COUNTRY=KE

# ── Airtel Africa Open API, Collection (Kenya direct) ──
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES

# ── The learning agent ──
AQUA_ASK_URL=https://aqua-ask.onrender.com
# Optional: transcribes spoken questions on the voice line with Gemini.
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.5-flash-lite
# Human guides who get ticket alerts and take call-backs, comma-separated.
AGENT_PHONES=

# ── Limits ──
# Per-country amounts and limits live in src/lib/countries.ts. The support meter counts gifts.
MOBILE_GOAL_GIFTS=500
# Practice payments confirm themselves after this many ms (0 = wait for a PIN on the simulator).
MOCK_CONFIRM_MS=8000
